APP_NAME="Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lokal saja. Produksi (satu-satunya backend): APP_URL=https://anaklangit.manahpro.web.id
APP_URL=http://localhost
API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_starter
DB_USERNAME=postgres
DB_PASSWORD=

# ==============================================================================
# PASSPORT CLIENT CONFIGURATION (CRITICAL FOR AUTHENTICATION API)
# ==============================================================================
# You MUST generate a Password Grant Client by running:
#    php artisan passport:client --password
# Then copy the outputted Client ID and Client Secret below.
# Without this, login endpoint (/api/v1/auth/login) will fail.
# ==============================================================================
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# local = store on disk (dev), public = publicly accessible local disk, s3 = S3-compatible object storage (prod)
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / S3-compatible object storage (set FILESYSTEM_DISK=s3 for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Cloud Storage (disk 'gcs' — requires: composer require spatie/laravel-google-cloud-storage)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
GOOGLE_CLOUD_STORAGE_API_URI=

# Login Google: client ID OAuth (Google Cloud Console) yang boleh menjadi audiens ID token.
# Isi minimal Web client ID yang dipakai app sebagai serverClientId; pisahkan dengan koma.
GOOGLE_CLIENT_IDS=

# SMS provider for OTP (default: log driver — messages written to laravel.log)
# Swap LogSmsProvider for Twilio, Vonage, or local provider in AppServiceProvider
SMS_PROVIDER=log

# Firebase / FCM push notifications
# Leave blank to use the log driver (no real push sent — useful in dev/test)
FIREBASE_CREDENTIALS=
# FIREBASE_CREDENTIALS=/path/to/service-account.json

# Distribusi APK dev (link /apk/{app}/{channel}) — lihat docs/APP_RELEASE.md
# local = storage/app/private di server; hanya APK terbaru per app+channel yang disimpan.
APP_RELEASE_DISK=local
APP_RELEASE_MAX_SIZE_MB=300

VITE_APP_NAME="${APP_NAME}"

# Set to true to include region data (~245k records) when running db:seed
# Run `php artisan regions:download` first, then `php artisan regions:seed`
SEED_REGIONS=false
